{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/ads.txt", "dest": "/ads.txt" },
    { "src": "/news", "dest": "https://news.studplex.com/?proxied=true" },
    { "src": "/news/(.*)", "dest": "https://news.studplex.com/$1?proxied=true" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
