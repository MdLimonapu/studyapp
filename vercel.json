{
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/news", "destination": "https://news.studplex.com?proxied=true" },
    { "source": "/news/:path*", "destination": "https://news.studplex.com/:path*?proxied=true" },
    { "source": "/((?!assets/|favicon.ico|sitemap.xml|robots.txt|index.html|index).*)", "destination": "/index.html" }
  ]
}
